.SH "NAME"
width\-controls \- table width controls
.SH "DESCRIPTION"
.sp
\fBTable 1. Repeated widths with automatic space\fR
.br
.TS
allbox expand tab(:);
ltw(2n) ltw(2n) lt.
A:B:Automatic space
.TE
.sp
\fBTable 2. Mixed numeric and percentage weights\fR
.br
.TS
allbox expand tab(:);
ltw(1n) ltw(59n).
A:B
.TE
.sp
\fBTable 3. All zero numeric widths\fR
.br
.TS
allbox expand tab(:);
ltw(30n) ltw(30n).
A:B
.TE
.sp
\fBTable 4. Zero beside automatic width\fR
.br
.TS
allbox expand tab(:);
ltw(1n) lt.
A:Automatic space
.TE
.sp
\fBTable 5. Maximum repeated widths\fR
.br
.TS
allbox expand tab(:);
ltw(30n) ltw(30n) lt.
A:B:Automatic space
.TE
