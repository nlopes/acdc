.SH "NAME"
table\-combined\-span\-formatting \- test combined table span formatting
.SH "SYNOPSIS"
.sp
\fBtable\-combined\-span\-formatting\fR
.SH "DESCRIPTION"
.SS "Column defaults"
.sp
\fBTable 1. Defaults follow source cells\fR
.br
.TS
allbox tab(:);
cx s cx
^ ^ cx
rdx ltx cx.
T{
\fICombined \fBbold\fI Ada\fR
T}:T{
\fIFirst companion \fBbold\fI Ada\fR
T}
\^:\^:T{
\fBSecond companion \fIitalic\fB Ada\fR
T}
T{
\fBFirst \fBbold\fB\fR
T}:T{
\fISecond \fBbold\fI\fR
T}:T{
Third \fIitalic\fR
T}
.TE
.sp
\fBTable 2. Duplicates use each column\fR
.br
.TS
allbox tab(:);
rdx ltx cx.
T{
\fBRepeated \fBbold\fB Ada\fR
T}:T{
\fIRepeated \fBbold\fI Ada\fR
T}:T{
Repeated \fBbold\fR Ada
T}
.TE
.SS "Explicit span formats"
.TS
allbox tab(:);
